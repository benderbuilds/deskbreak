# ---------------------------------------------------------------------------
# Everything here is optional for local development. DeskBreak Free works with
# none of it set; each block below turns on one capability.
# ---------------------------------------------------------------------------

# Absolute origin, used for Stripe redirects, canonical URLs and the sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe -----------------------------------------------------------------
# Create a monthly and an annual recurring price, then paste the Price IDs.
# Without these, checkout returns "temporarily unavailable" and never charges.
STRIPE_SECRET_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# --- Prices shown in the UI -------------------------------------------------
# Display only. These must match the Stripe prices above.
NEXT_PUBLIC_PRO_MONTHLY_PRICE=5.99
NEXT_PUBLIC_PRO_ANNUAL_PRICE=39
NEXT_PUBLIC_PRO_ANNUAL_LIST_PRICE=59
# Only set this if the Stripe price is actually configured with a trial.
NEXT_PUBLIC_PRO_TRIAL_DAYS=0

# --- Supabase ---------------------------------------------------------------
# On Vercel these are injected by the Supabase integration; do not set them by
# hand there. Only fill them in for local development against a real project.
# Without them, profiles and subscriptions live in memory and do not survive a
# restart. Required in production: entitlement has to be durable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Email reminders --------------------------------------------------------
RESEND_API_KEY=
REMINDER_FROM_EMAIL=DeskBreak <hello@deskbreak.app>
# Shared secret the reminder scheduler sends as `Authorization: Bearer ...`.
CRON_SECRET=

# --- Sign-in (magic links) --------------------------------------------------
# Signs session cookies and hashes one-time login tokens. Any long random
# string. Falls back to CRON_SECRET when unset.
AUTH_SECRET=
# How long a sign-in link stays valid. Default 30.
AUTH_LINK_TTL_MINUTES=30
# Outside production only: return the sign-in link in the API response instead
# of emailing it, so the flow can be tested without an email provider. Ignored
# whenever the runtime is production.
AUTH_DEV_LINKS=
# Marks a self-hosted deployment as production (Vercel sets VERCEL_ENV itself).
# Production refuses to offer accounts or checkout on the in-memory store and
# never hands out dev links.
DESKBREAK_ENV=

# --- Web Push -----------------------------------------------------------------
# Generate once with `npm run push:keys`. Rotating them invalidates every
# subscription. The public key is safe to expose; the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@deskbreak.app
