# ---------------------------------------------------------------------------
# Everything here is optional for local development. DeskBreak Free works with
# none of it set; each block below turns on one capability.
# ---------------------------------------------------------------------------

# Absolute origin, used for Stripe redirects, canonical URLs and the sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe -----------------------------------------------------------------
# Create a monthly and an annual recurring price, then paste the Price IDs.
# Without these, checkout returns "temporarily unavailable" and never charges.
STRIPE_SECRET_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# --- Prices shown in the UI -------------------------------------------------
# Display only. These must match the Stripe prices above.
NEXT_PUBLIC_PRO_MONTHLY_PRICE=5.99
NEXT_PUBLIC_PRO_ANNUAL_PRICE=39
NEXT_PUBLIC_PRO_ANNUAL_LIST_PRICE=59
# Only set this if the Stripe price is actually configured with a trial.
NEXT_PUBLIC_PRO_TRIAL_DAYS=0

# --- Supabase ---------------------------------------------------------------
# Without these, profiles and subscriptions live in memory and do not survive a
# restart. Required in production: entitlement has to be durable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Email reminders --------------------------------------------------------
RESEND_API_KEY=
REMINDER_FROM_EMAIL=DeskBreak <hello@deskbreak.app>
# Shared secret the reminder scheduler sends as `Authorization: Bearer ...`.
CRON_SECRET=
