{
  "name": "deskbreak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:unit": "playwright test tests/recommendation.spec.ts tests/art.spec.ts tests/workday.spec.ts tests/migration.spec.ts --project=mobile",
    "test:server": "playwright test -c playwright.server.config.ts",
    "test:server:postgres": "DESKBREAK_TEST_STORE=postgres playwright test -c playwright.server.config.ts",
    "postgres:shim": "node tests/postgres/postgrest-shim.mjs",
    "test:security": "playwright test tests/api-security.spec.ts --project=mobile",
    "push:keys": "node scripts/generate-vapid.mjs",
    "art:manifest": "node scripts/build-art-manifest.mjs",
    "art:audit": "node scripts/audit-art.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.6.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
